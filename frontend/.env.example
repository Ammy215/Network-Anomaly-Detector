# NetSentinel — frontend environment variables
# Copy this file to frontend/.env and fill in your Supabase project's values
# (Dashboard -> Project Settings -> API). The anon key is meant to be
# public -- it's safe to ship to the browser.

VITE_SUPABASE_URL=your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
