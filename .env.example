# NetSentinel — environment variables
# Copy this file to backend/.env and fill in real values as each phase needs them.
# Nothing here is required for Phase 0 (foundation skeleton) to run.

# ── App ────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Origins the FastAPI backend will accept browser requests from (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:5173

# ── Supabase — DB + Auth (needed from Phase 0 setup onward, no calls made yet) ──
# Free signup: https://supabase.com/dashboard/sign-up
SUPABASE_URL=your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Threat Intelligence APIs (needed from Phase 5 — enrichment) ─────
# Free signup: https://www.abuseipdb.com/register (1000 checks/day)
ABUSEIPDB_API_KEY=your-abuseipdb-key
# Free signup: https://otx.alienvault.com/accounts/register
OTX_API_KEY=your-otx-key
# Free signup: https://ipinfo.io/signup (50k lookups/month)
IPINFO_API_KEY=your-ipinfo-key
# Free signup: https://www.virustotal.com/gui/join-us (500 lookups/day)
VIRUSTOTAL_API_KEY=your-virustotal-key
# Free, no cost — key just raises rate limit: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your-nvd-key

# ── AI / LLM (needed from Phase 7 — AI investigation pipeline) ──────
# Provider verified for a genuinely free tier at that phase (candidates: Groq, Google AI Studio/Gemini)
LLM_API_KEY=your-llm-provider-key

# ── Vector DB — RAG (needed from Phase 6 — knowledge base) ──────────
# Chroma runs locally by default; only set this if a remote instance is used
VECTOR_DB_URL=
